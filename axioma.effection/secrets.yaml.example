# Copy this to secrets.yaml and fill in your own values.
# DO NOT add secrets.yaml to version control.

wifi_ssid: "NetworkName"
wifi_password: "network-password"

# Password for the fallback AP (at least 8 characters)
ap_password: "change-this"

# Generate with:  esphome config axioma.effection.yaml
# or at https://esphome.io/components/api.html (Generate key)
api_encryption_key: "replace-this-with-a-32-byte-base64-key"

# `ota_password` is no longer used: OTA is encrypted with the API key, and
# `encryption:` in the ota block rejects unencrypted uploads.

# The meter's AES-128 key, 32 hex characters.
#
# This is not needed until the radio has been shown to work — even
# encrypted telegrams show up in the log and reveal the Meter ID. Ask the
# water utility, the building manager or the meter's supplier; that takes
# calendar time, so put the request in motion before connecting anything.
#
# Leave as a placeholder until the key arrives.
meter_key: "00000000000000000000000000000000"
