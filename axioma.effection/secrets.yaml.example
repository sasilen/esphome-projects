# Kopioi tämä nimelle secrets.yaml ja täytä omat arvot.
# ÄLÄ lisää secrets.yaml-tiedostoa versionhallintaan.

wifi_ssid: "VerkonNimi"
wifi_password: "verkon-salasana"

# AP-varayhteyden salasana (vähintään 8 merkkiä)
ap_password: "vesimittari123"

# Luo komennolla:  esphome config axioma.effection.yaml
# tai osoitteessa https://esphome.io/components/api.html (Generate key)
api_encryption_key: "korvaa-tama-32-tavun-base64-avaimella"

ota_password: "ota-salasana"

# Mittarin AES-128-avain, 32 heksamerkkiä.
#
# Tätä ei tarvita ennen kuin radio on todettu toimivaksi — salatutkin
# telegrammit näkyvät lokissa ja kertovat Meter ID:n. Pyydä avain
# vesilaitokselta, isännöitsijältä tai mittarin toimittajalta; siihen menee
# kalenteriaikaa, joten laita pyyntö liikkeelle ennen kuin kytket mitään.
#
# Jätä paikanpitäjäksi kunnes avain saapuu.
meter_key: "00000000000000000000000000000000"
