# --- Salaisuudet -------------------------------------------------------------
# secrets.yaml.example jää versionhallintaan, oikea secrets.yaml ei.
secrets.yaml
!secrets.yaml.example
*.secret
*.key
*.pem

# --- ESPHome -----------------------------------------------------------------
.esphome/
# ESPHome kirjoittaa käännöshakemistot tänne (build/, .pioenvs/, external_components/)

# --- PlatformIO / Arduino ----------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
*.map

# --- Ulkopuoliset työkopiot --------------------------------------------------
upstream/
vendor/

# --- Valmistajien manuaalit --------------------------------------------------
# Kolmannen osapuolen dokumentteihin linkitetään lähteessään, niitä ei kopioida
# tänne. Työkopion voi pitää paikallisesti.
*.pdf

# --- Käännösartefaktit -------------------------------------------------------
*.o
*.obj
*.d
*.a
*.lib
*.so
*.dylib
*.dll
*.elf
*.bin
*.hex

# Puhelimesta tuodut kuvat odottavat metadatan poistoa, eivätkä ne saa päätyä
# committiin sellaisenaan: GPS on muutaman metrin tarkkuudella. Tuo ne tähän
# hakemistoon, aja convert-putki ja kopioi tulos projektihakemistoon.
s/
inbox/

# Sama koskee kuvia jotka putoavat suoraan juureen kameran omalla nimellä —
# ne eivät ole käyneet convert-putken läpi. Polku on ankkuroitu juureen, jotta
# projektihakemistojen käsitellyt kuvat eivät osu tähän.
/PXL_*
/IMG_*
/DSC*

# Keskeneräinen selainlataus. ESPHomen "Install -> Manual download" pudottaa
# .bin-tiedoston, joka on jo yllä — mutta kesken jäänyt lataus on .crdownload
# eikä osu siihen, ja päätyi kerran committiin asti.
*.crdownload
*.part

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- Claude Code / työympäristö ----------------------------------------------
# /workspace on tässä kontissa myös HOME, joten koko .claude-hakemisto
# (credentials, keskusteluhistoria, istunnot) jää ulkopuolelle.
.claude/*
.claude.json
.claude.json.backup*
.commandhistory/
.mcp.json

# --- Editorit ja käyttöjärjestelmä -------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Väliaikaiset ------------------------------------------------------------
*.log
*.bak
*.tmp
!.claude/skills

# Kolmannen osapuolen taulukkokaappaukset — linkitä lähteeseen, älä kopioi.
# Polut on ankkuroitu juureen (`/`), koska projektihakemistoissa on omia
# kuvia samoilla nimillä — esim. axioma.effection/cc1101-module.jpg on
# itse otettu ja kuuluu repoon.
fe95ef33*.jpeg
/CC1101*
/cc1101*
/*_files/

# ESPHomen käännöstuotteet. Firmware rakennetaan YAMLista, ei säilötä.
*.bin
