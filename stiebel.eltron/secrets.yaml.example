# Copy this to secrets.yaml and fill in your own values.
# Do NOT commit secrets.yaml.

wifi_ssid: "YourNetwork"
wifi_password: "network-password"

# Fallback access point password (at least 8 characters)
ap_password: "vaihda-tama"

# Generate with:  esphome config stiebel.eltron.yaml
# or at https://esphome.io/components/api.html (Generate key)
api_encryption_key: "korvaa-tama-32-tavun-base64-avaimella"

# `ota_password` ei ole enää käytössä: OTA on salattu API-avaimella,
# ja `encryption:` ota-lohkossa hylkää salaamattoman lähetyksen.
