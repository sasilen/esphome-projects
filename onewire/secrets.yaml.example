# Kopioi tämä nimelle secrets.yaml ja täytä omat arvot.
# ÄLÄ lisää secrets.yaml-tiedostoa versionhallintaan.

wifi_ssid: "VerkonNimi"
wifi_password: "verkon-salasana"

# Varayhteyden AP-salasana (vähintään 8 merkkiä).
# Verkon nimi ("1-Wire fallback") ei ole salaisuus — se lähetetään ilmaan
# joka tapauksessa. Vain salasana kuuluu tänne.
ap_password: "vaihda-tama"

# Luo komennolla:  openssl rand -base64 32
# tai osoitteessa https://esphome.io/components/api.html (Generate key)
api_encryption_key: "korvaa-tama-32-tavun-base64-avaimella"

# `ota_password` ei ole enää käytössä: OTA on salattu API-avaimella,
# ja `encryption:` ota-lohkossa hylkää salaamattoman lähetyksen.
