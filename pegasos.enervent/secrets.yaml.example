# Copy this to secrets.yaml and fill in your own values.
# Do NOT add secrets.yaml to version control — .gitignore blocks it.

wifi_ssid: "NetworkName"
wifi_password: "network-password"

# Password for the fallback access point, at least 8 characters.
#
# This is the one that gets forgotten, because it feels like a setting on the
# device rather than a network credential. The AP's *name* is not a secret —
# it is broadcast — and it stays in the YAML.
ap_password: "pegasos-fallback"

# Generate with:  esphome config pegasos.enervent.yaml
# or at https://esphome.io/components/api.html (Generate key)
api_encryption_key: "replace-with-a-32-byte-base64-key"

ota_password: "ota-password"

# Nothing on the Modbus side belongs here. The slave address is not a secret
# and it is a substitution at the top of the YAML, because it is a value to
# sweep rather than a credential to protect.
