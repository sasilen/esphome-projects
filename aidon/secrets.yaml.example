# Kopioi tämä nimelle secrets.yaml ja täytä omat arvot.
# ÄLÄ lisää secrets.yaml-tiedostoa versionhallintaan.

wifi_ssid: "VerkonNimi"
wifi_password: "verkon-salasana"

# Varayhteyden AP-salasana (vähintään 8 merkkiä).
# Verkon nimi ("Aidon Fallback Hotspot") ei ole salaisuus — se lähetetään
# ilmaan joka tapauksessa. Vain salasana kuuluu tänne.
ap_password: "vaihda-tama"

# Luo komennolla:  openssl rand -base64 32
# tai osoitteessa https://esphome.io/components/api.html (Generate key)
#
# **Laitekohtainen nimi.** ESPHome-kontin /config on litteä ja siellä on yksi
# jaettu secrets.yaml, joten sama nimi ei voi tarkoittaa eri arvoa eri
# laitteille. api_encryption_key on varattu stiebelille ja onewirelle.
aidon_api_key: "korvaa-tama-32-tavun-base64-avaimella"

ota_password: "ota-salasana"
